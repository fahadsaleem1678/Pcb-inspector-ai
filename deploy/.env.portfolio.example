# Copy to deploy/.env.portfolio on the server; never commit real values.
PCB_API_HOST=api.example.com
PCB_ENVIRONMENT=portfolio
PCB_AUTH_MODE=cognito
PCB_COGNITO_USER_POOL_ID=us-east-1_REPLACE
PCB_COGNITO_CLIENT_ID=REPLACE
PCB_CORS_ORIGINS=["https://your-project.vercel.app"]
# Supabase Connect panel: session pooler, port 5432. URL-encode password.
PCB_DATABASE_URL=postgresql+psycopg://postgres.PROJECT:PASSWORD@POOLER:5432/postgres?sslmode=require
PCB_STORAGE_BACKEND=s3
PCB_AWS_REGION=us-east-1
PCB_S3_BUCKET=replace-private-bucket
PCB_S3_PREFIX=pcb-portfolio
PCB_QUEUE_BACKEND=database
PCB_DETECTOR=research
PCB_RESEARCH_CHECKPOINT=/models/final-research.pt
PCB_MAX_UPLOAD_BYTES=10485760
PCB_MAX_IMAGE_PIXELS=20000000
PCB_LEASE_SECONDS=120
# Use an EC2 instance role for AWS credentials, not access keys.
