{
  "$defs": {
    "Annotation": {
      "additionalProperties": false,
      "properties": {
        "class_id": {
          "minimum": 0,
          "title": "Class Id",
          "type": "integer"
        },
        "bbox": {
          "$ref": "#/$defs/BoundingBox"
        }
      },
      "required": [
        "class_id",
        "bbox"
      ],
      "title": "Annotation",
      "type": "object"
    },
    "BoundingBox": {
      "properties": {
        "x1": {
          "minimum": 0,
          "title": "X1",
          "type": "number"
        },
        "y1": {
          "minimum": 0,
          "title": "Y1",
          "type": "number"
        },
        "x2": {
          "exclusiveMinimum": 0,
          "title": "X2",
          "type": "number"
        },
        "y2": {
          "exclusiveMinimum": 0,
          "title": "Y2",
          "type": "number"
        }
      },
      "required": [
        "x1",
        "y1",
        "x2",
        "y2"
      ],
      "title": "BoundingBox",
      "type": "object"
    },
    "DatasetLicense": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "evidence": {
          "minLength": 1,
          "title": "Evidence",
          "type": "string"
        },
        "allowed_uses": {
          "items": {
            "enum": [
              "research",
              "public_demo",
              "commercial"
            ],
            "type": "string"
          },
          "title": "Allowed Uses",
          "type": "array"
        },
        "reviewed_by": {
          "minLength": 1,
          "title": "Reviewed By",
          "type": "string"
        },
        "reviewed_on": {
          "format": "date",
          "title": "Reviewed On",
          "type": "string"
        }
      },
      "required": [
        "name",
        "evidence",
        "allowed_uses",
        "reviewed_by",
        "reviewed_on"
      ],
      "title": "DatasetLicense",
      "type": "object"
    },
    "Sample": {
      "additionalProperties": false,
      "properties": {
        "image": {
          "minLength": 1,
          "title": "Image",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "integer"
        },
        "group_id": {
          "minLength": 1,
          "title": "Group Id",
          "type": "string"
        },
        "split": {
          "enum": [
            "train",
            "validation",
            "test"
          ],
          "title": "Split",
          "type": "string"
        },
        "annotations": {
          "items": {
            "$ref": "#/$defs/Annotation"
          },
          "title": "Annotations",
          "type": "array"
        }
      },
      "required": [
        "image",
        "sha256",
        "width",
        "height",
        "group_id",
        "split",
        "annotations"
      ],
      "title": "Sample",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "version": {
      "minLength": 1,
      "title": "Version",
      "type": "string"
    },
    "source_url": {
      "format": "uri",
      "maxLength": 2083,
      "minLength": 1,
      "title": "Source Url",
      "type": "string"
    },
    "source_revision": {
      "minLength": 1,
      "title": "Source Revision",
      "type": "string"
    },
    "license": {
      "$ref": "#/$defs/DatasetLicense"
    },
    "classes": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Classes",
      "type": "array"
    },
    "samples": {
      "items": {
        "$ref": "#/$defs/Sample"
      },
      "minItems": 1,
      "title": "Samples",
      "type": "array"
    }
  },
  "required": [
    "name",
    "version",
    "source_url",
    "source_revision",
    "license",
    "classes",
    "samples"
  ],
  "title": "DatasetManifest",
  "type": "object"
}
