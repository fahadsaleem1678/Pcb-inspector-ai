# Local single-user demo only.
PCB_ENVIRONMENT=local
PCB_DETECTOR=demo
PCB_DATABASE_URL=sqlite:///.runtime/pcb.db
PCB_STORAGE_PATH=.runtime/objects
PCB_MAX_UPLOAD_BYTES=10485760
PCB_MAX_IMAGE_PIXELS=20000000
PCB_LEASE_SECONDS=120
PCB_MAX_ATTEMPTS=3

# Optional Cognito verification; browser PKCE configuration: docs/authentication.md.
PCB_AUTH_MODE=local
# PCB_COGNITO_USER_POOL_ID=us-east-1_YourPoolId
# PCB_COGNITO_CLIENT_ID=YourAppClientId
# PCB_COGNITO_REQUIRED_SCOPES=["your-resource/inspect"]

# Opt-in cloud adapters for authorized integration testing (still demo/local gated).
PCB_STORAGE_BACKEND=local
PCB_QUEUE_BACKEND=database
# PCB_AWS_REGION=us-east-1
# PCB_S3_BUCKET=your-private-bucket
# PCB_S3_PREFIX=pcb-inspector
# PCB_S3_KMS_KEY_ID=your-key-arn
# PCB_SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/pcb-inspections
# PCB_SQS_VISIBILITY_SECONDS=120
# PCB_OUTBOX_LEASE_SECONDS=120
# Use the AWS SDK credential chain / task roles. Never commit AWS credentials.
